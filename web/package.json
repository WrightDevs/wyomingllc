{
  "name": "wyomingllc-web",
  "version": "0.1.0",
  "private": true,
  "description": "Wyoming LLC formation portal — React/TypeScript on Next.js with Neon Postgres.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types tests/vectors.mjs",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-db.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "@neon/realtime": "^0.1.2",
    "@neondatabase/serverless": "1.2.0",
    "@noble/curves": "1.4.0",
    "@noble/hashes": "1.4.0",
    "@scure/bip32": "1.4.0",
    "@scure/bip39": "1.3.0",
    "bech32": "2.0.0",
    "bs58": "5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "resend": "^6.35.0",
    "tailwind-merge": "^3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.2"
  }
}
