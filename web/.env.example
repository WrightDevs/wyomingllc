# Copy to .env.local and fill in. Nothing here is committed.

# Neon pooled connection string (Project → Connection Details → Pooled connection).
DATABASE_URL="postgres://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/wyomingllc?sslmode=require"

# 32+ random bytes, base64. Signs the AES key used to encrypt stored phrases.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-me-with-48-random-bytes"

# Public origin, used for absolute links in the UI.
APP_URL="http://localhost:3000"

# Optional: `npm run db:setup` creates this administrator when both are set.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Console Admin"

# Resend Email Delivery (https://resend.com)
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="Wyoming Attorney <onboarding@resend.dev>"
